# ── ProjectFlow Environment Variables Template (Supabase Ready) ────────────

NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Supabase PostgreSQL Database ───────────────────────────────────────────
# Get these from Supabase Dashboard -> Settings -> Database -> Connection string
# 1. Transaction Pooler (for Node/Nest API queries):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection (for Prisma migrate / db push):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ── Supabase Project Keys (Optional) ───────────────────────────────────────
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Authentication ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="generate-a-strong-32-character-secret-key-here"

# ── Seed ───────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@projectflow.local
SEED_ADMIN_NAME="System Administrator"
SEED_PASSWORD=ChangeMe!2026
