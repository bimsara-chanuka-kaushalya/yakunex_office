// ProjectFlow by Yakunex Technologies (Pvt) Ltd.
// PostgreSQL schema. Every tenant-owned table carries organizationId.
// Phase markers below show when each group is implemented in the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  PROJECT_MANAGER
  STAFF
  INTERN
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ProjectStatus {
  NEW_REQUEST
  PLANNING
  IN_PROGRESS
  ON_HOLD
  TESTING
  CLIENT_REVIEW
  DEPLOYMENT
  COMPLETED
  CANCELLED
}

enum ProjectCategory {
  WEB_DEVELOPMENT
  MOBILE_APPLICATION
  DESKTOP_SOFTWARE
  AI_ML
  DATABASE_SYSTEMS
  UI_UX_DESIGN
  IT_CONSULTING
  OTHER
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  TESTING
  BLOCKED
  COMPLETED
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum BugSeverity {
  MINOR
  MAJOR
  CRITICAL
  BLOCKER
}

enum BugStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  FIXED
  TESTING
  VERIFIED
  CLOSED
}

enum TimeEntrySource {
  TIMER
  MANUAL
  CORRECTION
}

enum ActivityState {
  ACTIVE
  IDLE
  PAUSED
  OFFLINE
}

enum ActivityEventType {
  HEARTBEAT
  POINTER
  KEYBOARD
  VISIBILITY
  FOCUS
  IDLE_WARNING
  IDLE_CONFIRMED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChannelType {
  DIRECT
  GROUP
  PROJECT
  DEPARTMENT
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum IntegrationProvider {
  GITHUB
  GITLAB
  JITSI
  ZOOM
}

enum DocumentType {
  SRS
  PROPOSAL
  CONTRACT
  REQUIREMENT
  DESIGN
  API_DOC
  TECHNICAL_DOC
  USER_MANUAL
  MEETING_NOTE
  DELIVERABLE
  OTHER
}

enum ApprovalType {
  TIMESHEET
  LEAVE
  TASK
  DELIVERABLE
  PROJECT_STAGE
}

// ─── Organization & structure (Phase 1) ───────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Asia/Colombo")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  departments     Department[]
  teams           Team[]
  clients         Client[]
  projects        Project[]
  tasks           Task[]
  sprints         Sprint[]
  bugs            Bug[]
  timeEntries     TimeEntry[]
  activitySessions ActivitySession[]
  attendance      Attendance[]
  timesheets      Timesheet[]
  leaveRequests   LeaveRequest[]
  publicHolidays  PublicHoliday[]
  notifications   Notification[]
  chatChannels    ChatChannel[]
  meetings        Meeting[]
  documents       Document[]
  repositories    Repository[]
  integrations    Integration[]
  internProfiles  InternProfile[]
  trainingPlans   TrainingPlan[]
  evaluations     Evaluation[]
  approvals       Approval[]
  auditLogs       AuditLog[]
  systemSettings  SystemSetting[]
  refreshTokens   RefreshToken[]
  rolePermissions RolePermission[]
  attachments     Attachment[]
  milestones      Milestone[]
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  teams        Team[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Team {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  leadId         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lead         User?        @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members      TeamMember[]
  projects     Project[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ─── Users, authentication & RBAC (Phase 1) ───────────────────────────────

model User {
  id                 String     @id @default(cuid())
  organizationId     String
  companyId          String?    @unique
  email              String     @unique
  passwordHash       String
  fullName           String
  phone              String?
  avatarUrl          String?
  title              String?
  role               Role       @default(STAFF)
  status             UserStatus @default(ACTIVE)
  departmentId       String?
  timezone           String     @default("Asia/Colombo")
  mustChangePassword Boolean    @default(false)
  twoFactorEnabled   Boolean    @default(false)
  twoFactorSecret    String?
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  refreshTokens      RefreshToken[]
  permissionOverrides UserPermission[]
  teamMemberships    TeamMember[]
  ledTeams           Team[]             @relation("TeamLead")
  projectMemberships ProjectMember[]
  managedProjects    Project[]          @relation("ProjectManager")
  ownedStages        ProjectStage[]     @relation("StageOwner")
  taskAssignments    TaskAssignee[]
  createdTasks       Task[]             @relation("TaskCreator")
  reportedBugs       Bug[]              @relation("BugReporter")
  assignedBugs       Bug[]              @relation("BugAssignee")
  timeEntries        TimeEntry[]
  activitySessions   ActivitySession[]
  attendance         Attendance[]
  breaks             Break[]
  timesheets         Timesheet[]        @relation("TimesheetOwner")
  approvedTimesheets Timesheet[]        @relation("TimesheetApprover")
  leaveRequests      LeaveRequest[]     @relation("LeaveRequester")
  leaveDecisions     LeaveRequest[]     @relation("LeaveApprover")
  notifications      Notification[]
  chatMemberships    ChatMember[]
  messages           Message[]
  organizedMeetings  Meeting[]          @relation("MeetingOrganizer")
  meetingAttendance  MeetingAttendee[]
  meetingNotes       MeetingNote[]
  comments           Comment[]
  attachments        Attachment[]
  documents          Document[]
  repositoriesConnected Repository[]
  integrationsCreated   Integration[]
  approvalsRequested Approval[]         @relation("ApprovalRequester")
  approvalsDecided   Approval[]         @relation("ApprovalDecider")
  internProfile      InternProfile?     @relation("InternUser")
  mentoredInterns    InternProfile[]    @relation("MentorOf")
  evaluationsGiven   Evaluation[]       @relation("Evaluator")
  auditLogs          AuditLog[]

  @@index([organizationId])
  @@index([companyId])
  @@index([departmentId])
  @@index([role])
}

model RefreshToken {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  familyId       String
  tokenHash      String    @unique
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([organizationId])
}

// Role → permission defaults. Editable by Super Admin / Admin through the Permissions page.
model RolePermission {
  id             String   @id @default(cuid())
  organizationId String
  role           Role
  permissionKey  String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, permissionKey])
  @@index([organizationId])
}

// Per-user granular overrides on top of the role defaults.
model UserPermission {
  id            String   @id @default(cuid())
  userId        String
  permissionKey String
  granted       Boolean  // true = grant, false = revoke
  grantedById   String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionKey])
}

// ─── Clients & projects (Phase 2) ─────────────────────────────────────────

model Client {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organizationId])
}

model Project {
  id              String          @id @default(cuid())
  organizationId  String
  code            String          // Project ID shown to users, e.g. PRJ-2026-001
  name            String
  description     String?
  clientId        String?
  category        ProjectCategory @default(OTHER)
  projectType     String?
  status          ProjectStatus   @default(NEW_REQUEST)
  priority        Priority        @default(MEDIUM)
  budget          Decimal?        @db.Decimal(14, 2)
  currency        String          @default("LKR")
  startDate       DateTime?
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  managerId       String?
  teamId          String?
  techStack       String[]
  progressPercent Decimal         @default(0) @db.Decimal(5, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager      User?           @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  team         Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  stages       ProjectStage[]
  milestones   Milestone[]
  tasks        Task[]
  sprints      Sprint[]
  bugs         Bug[]
  timeEntries  TimeEntry[]
  documents    Document[]
  chatChannels ChatChannel[]
  meetings     Meeting[]
  repositories Repository[]
  attachments  Attachment[]
  approvals    Approval[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([managerId])
  @@index([clientId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleInProject String @default("MEMBER")
  allocationPercent Int @default(100)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// Configurable development lifecycle stages (Client Request … Project Closure).
model ProjectStage {
  id           String      @id @default(cuid())
  projectId    String
  position     Int
  name         String
  status       StageStatus @default(PENDING)
  ownerId      String?
  dueDate      DateTime?
  deliverables String?
  approved     Boolean     @default(false)
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("StageOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([projectId, position])
}

model Milestone {
  id          String    @id @default(cuid())
  organizationId String
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([projectId])
}

// ─── Tasks & Agile (Phase 2) ──────────────────────────────────────────────

model Sprint {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  goal           String?
  status         SprintStatus @default(PLANNED)
  startDate      DateTime?
  endDate        DateTime?
  retrospective  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  bugs         Bug[]

  @@index([projectId])
}

model Task {
  id              String     @id @default(cuid())
  organizationId  String
  projectId       String
  sprintId        String?
  milestoneId     String?
  code            String     // e.g. PRJ-2026-001-T042
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  storyPoints     Int?
  estimatedHours  Decimal?   @db.Decimal(6, 2)
  actualHours     Decimal    @default(0) @db.Decimal(8, 2)
  labels          String[]
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  position        Int        @default(0)
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?            @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  milestone    Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignees    TaskAssignee[]
  subtasks     Subtask[]
  dependsOn    TaskDependency[]   @relation("DependentTask")
  dependents   TaskDependency[]   @relation("PrerequisiteTask")
  comments     Comment[]
  attachments  Attachment[]
  timeEntries  TimeEntry[]
  bugs         Bug[]

  @@unique([projectId, code])
  @@index([organizationId, status])
  @@index([projectId, sprintId])
  @@index([dueDate])
}

model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Subtask {
  id          String     @id @default(cuid())
  taskId      String
  title       String
  isDone      Boolean    @default(false)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskDependency {
  id              String         @id @default(cuid())
  taskId          String         // the dependent task
  dependsOnId     String         // the prerequisite task
  type            DependencyType @default(FINISH_TO_START)

  dependentTask    Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisiteTask Task @relation("PrerequisiteTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@index([dependsOnId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String?
  bugId     String?
  authorId  String
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())

  task   Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bug    Bug?   @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([bugId])
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  taskId         String?
  bugId          String?
  uploadedById   String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String   @unique  // object-storage key, never a public URL
  checksumSha256 String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  bug          Bug?         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([taskId])
  @@index([bugId])
}

// ─── Bugs & QA (Phase 5) ──────────────────────────────────────────────────

model Bug {
  id              String      @id @default(cuid())
  organizationId  String
  projectId       String
  sprintId        String?
  taskId          String?
  code            String      // e.g. BUG-0001
  title           String
  description     String?
  stepsToReproduce String?
  expectedResult  String?
  actualResult    String?
  severity        BugSeverity @default(MAJOR)
  priority        Priority    @default(MEDIUM)
  status          BugStatus   @default(NEW)
  reportedById   String
  assigneeId     String?
  verifiedById   String?
  verifiedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reporter     User         @relation("BugReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  assignee     User?        @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments     Comment[]
  attachments  Attachment[]

  @@unique([organizationId, code])
  @@index([projectId, status])
  @@index([assigneeId])
}

// ─── Time tracking & activity (Phase 3) ───────────────────────────────────

model TimeEntry {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  projectId      String?
  taskId         String?
  source         TimeEntrySource @default(TIMER)
  startedAt      DateTime
  endedAt        DateTime?      // null while the timer is running
  billable       Boolean         @default(true)
  note           String?
  correctionReason String?
  editedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // A partial unique index (WHERE ended_at IS NULL) enforcing one running timer per user
  // is added in the initial migration; see prisma/migrations/manual/001_single_running_timer.sql
  @@index([userId, startedAt])
  @@index([organizationId, startedAt])
}

model ActivitySession {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  timeEntryId    String?
  startedAt      DateTime
  endedAt        DateTime?
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       ActivityEvent[]

  @@index([userId, startedAt])
  @@index([organizationId])
}

// Stores only timestamps and event types. No coordinates, keystrokes or screenshots.
model ActivityEvent {
  id          String            @id @default(cuid())
  sessionId   String
  type        ActivityEventType
  state       ActivityState     @default(ACTIVE)
  occurredAt  DateTime

  session ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
}

model Attendance {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  workDate       DateTime  @db.Date
  clockInAt      DateTime?
  clockOutAt     DateTime?
  isLate         Boolean   @default(false)
  earlyDeparture Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks       Break[]

  @@unique([userId, workDate])
  @@index([organizationId, workDate])
}

model Break {
  id           String    @id @default(cuid())
  attendanceId String
  userId       String
  startedAt    DateTime
  endedAt      DateTime?

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Timesheet {
  id             String          @id @default(cuid())
  organizationId String
  userId         String
  periodStart    DateTime        @db.Date
  periodEnd      DateTime        @db.Date
  totalMinutes   Int             @default(0)
  overtimeMinutes Int            @default(0)
  billableMinutes Int            @default(0)
  status         TimesheetStatus @default(DRAFT)
  submittedAt    DateTime?
  approvedById   String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("TimesheetOwner", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("TimesheetApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, periodStart, periodEnd])
  @@index([organizationId, status])
}

// ─── Leave & calendar (Phase 3) ───────────────────────────────────────────

model LeaveRequest {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  type           LeaveType
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  days           Decimal        @db.Decimal(4, 1)
  reason         String?
  status         ApprovalStatus @default(PENDING)
  approverId     String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approver     User?        @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId, startDate])
}

model PublicHoliday {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

// ─── Notifications & approvals (Phase 4) ──────────────────────────────────

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  type           String    // e.g. TASK_ASSIGNED, MENTION, TIMESHEET_APPROVED
  title          String
  body           String?
  link           String?
  data           Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId, createdAt])
}

model Approval {
  id              String         @id @default(cuid())
  organizationId  String
  projectId       String?
  type            ApprovalType
  entityId        String         // id of the timesheet, leave, task, stage or deliverable
  requesterId     String
  approverId      String?
  status          ApprovalStatus @default(PENDING)
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requester    User         @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approver     User?        @relation("ApprovalDecider", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([entityId])
}

// ─── Chat & meetings (Phase 4) ────────────────────────────────────────────

model ChatChannel {
  id             String      @id @default(cuid())
  organizationId String
  projectId      String?
  departmentId   String?
  type           ChannelType @default(GROUP)
  name           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members      ChatMember[]
  messages     Message[]

  @@index([organizationId, type])
}

model ChatMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id        String    @id @default(cuid())
  channelId String
  senderId  String
  body      String
  mentions  String[]
  reactions Json?
  fileKey   String?
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model Meeting {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String?
  organizerId    String
  title          String
  agenda         String?
  startsAt       DateTime
  endsAt         DateTime
  status         MeetingStatus @default(SCHEDULED)
  provider       IntegrationProvider @default(JITSI)
  joinUrl        String?
  recordingUrl  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  organizer    User                @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  attendees    MeetingAttendee[]
  notes        MeetingNote[]

  @@index([organizationId, startsAt])
}

model MeetingAttendee {
  id          String    @id @default(cuid())
  meetingId   String
  userId      String
  present     Boolean?
  respondedAt DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
}

model MeetingNote {
  id          String   @id @default(cuid())
  meetingId   String
  authorId    String
  content     String
  actionItems Json?
  createdAt   DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

// ─── Documents & Git (Phase 5) ────────────────────────────────────────────

model Document {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  folder         String       @default("/")
  title          String
  type           DocumentType @default(OTHER)
  version        Int          @default(1)
  storageKey     String       @unique
  mimeType       String
  sizeBytes      Int
  visibility     String       @default("TEAM")
  uploadedById   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, projectId])
}

model Repository {
  id              String              @id @default(cuid())
  organizationId  String
  projectId       String?
  provider        IntegrationProvider
  fullName        String              // owner/name
  externalId      String?
  defaultBranch   String              @default("main")
  webhookSecretRef String?            // reference to a secret manager entry, never the secret itself
  connectedById   String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  connectedBy  User         @relation(fields: [connectedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, provider, fullName])
}

model Integration {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  name           String
  config         Json?               // non-secret settings only
  secretRef      String?             // pointer into the secrets manager
  isEnabled      Boolean             @default(false)
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, provider])
}

// ─── Internships (Phase 6) ────────────────────────────────────────────────

model InternProfile {
  id             String    @id @default(cuid())
  organizationId String
  userId         String    @unique
  mentorId       String?
  university     String?
  programme      String?
  startDate      DateTime  @db.Date
  endDate        DateTime? @db.Date
  progressPercent Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation("InternUser", fields: [userId], references: [id], onDelete: Cascade)
  mentor       User?          @relation("MentorOf", fields: [mentorId], references: [id], onDelete: SetNull)
  trainingPlans TrainingPlan[]
  evaluations  Evaluation[]

  @@index([organizationId])
  @@index([mentorId])
}

model TrainingPlan {
  id             String    @id @default(cuid())
  organizationId String
  internProfileId String
  title          String
  description    String?
  materials      Json?
  weekNumber     Int?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  internProfile InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)

  @@index([internProfileId])
}

model Evaluation {
  id              String   @id @default(cuid())
  organizationId  String
  internProfileId String
  evaluatorId     String
  period          String   // e.g. "2026-W45" or "2026-Q4"
  score           Int      // 1–5
  strengths       String?
  improvements    String?
  feedback        String?
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  internProfile InternProfile @relation(fields: [internProfileId], references: [id], onDelete: Cascade)
  evaluator     User          @relation("Evaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@index([internProfileId])
}

// ─── Platform & security (Phase 1) ────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String   // e.g. USER_CREATED, LOGIN_FAILED
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
}

model SystemSetting {
  id             String   @id @default(cuid())
  organizationId String
  key            String   // e.g. working_schedule, activity_policy
  value          Json
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}
